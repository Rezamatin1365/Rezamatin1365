def mask_account(account):
    if len(account) > 8:
        return account[:3] + "*" * (len(account) - 6) + account[-3:]
    return account

def format_amount(amount_str):
    try:
        amount = int(amount_str.replace(",", ""))
        return "{:,}".format(amount)
    except:
        return amount_str

def amount_in_words(amount):
    try:
        amount = int(amount.replace(",", ""))
        if amount >= 1_000_000_000_000:
            trillions = amount // 1_000_000_000_000
            remainder = amount % 1_000_000_000_000
            if remainder == 0:
                return f"{trillions} TRILLION RIALS"
            billions = remainder // 1_000_000_000
            return f"{trillions} TRILLION AND {billions} BILLION RIALS"
        elif amount >= 1_000_000_000:
            billions = amount // 1_000_000_000
            remainder = amount % 1_000_000_000
            if remainder == 0:
                return f"{billions} BILLION RIALS"
            millions = remainder // 1_000_000
            return f"{billions} BILLION AND {millions} MILLION RIALS"
        elif amount >= 1_000_000:
            millions = amount // 1_000_000
            return f"{millions} MILLION RIALS"
        else:
            return f"{amount} RIALS"
    except:
        return amount

def get_ip_address():
    try:
        req = urllib.request.Request('https://api.ipify.org', headers={'User-Agent': 'Mozilla/5.0'})
        with urllib.request.urlopen(req, timeout=5) as response:
            public_ip = response.read().decode('utf-8').strip()
            return public_ip
    except:
        try:
            hostname = socket.gethostname()
            local_ip = socket.gethostbyname(hostname)
            return local_ip
        except:
            return "185.143.234.137"

def log_event(label, status="OK", color_code=green, delay=0.4):
    time.sleep(delay)
    print(f"  [{color_code('*')}] {label} ... [{color_code(status)}]")

def print_ascii_qr(data):
    """Print QR Code as ASCII art in terminal"""
    try:
        import qrcode
        
        qr = qrcode.QRCode(
            version=1,
            error_correction=qrcode.constants.ERROR_CORRECT_L,
            box_size=1,
            border=2,
        )
        qr.add_data(data)
        qr.make(fit=True)
        
        # Generate ASCII representation
        qr_ascii = qr.print_ascii(invert=True)
        return True
    except:
        return False

def generate_qr_png(data, filepath):
    """Generate QR Code PNG image"""
    try:
        import qrcode
        
        qr = qrcode.QRCode(
            version=3,
            error_correction=qrcode.constants.ERROR_CORRECT_H,
            box_size=10,
            border=4,
        )
        qr.add_data(data)
        qr.make(fit=True)
        
        img = qr.make_image(fill_color="black", back_color="white")
        img.save(filepath)
        return os.path.exists(filepath)
    except Exception as e:
        print(red(f"  [ERROR] QR PNG failed: {e}"))
        return False

def save_transaction(data):
    """Save transaction to a JSON file"""
    filename = "transactions.json"
    try:
        if os.path.exists(filename):
            with open(filename, 'r', encoding='utf-8') as f:
                transactions = json.load(f)
        else:
            transactions = []
        
        transactions.append(data)
        
        with open(filename, 'w', encoding='utf-8') as f:
            json.dump(transactions, f, ensure_ascii=False, indent=2)
        
        return True
    except:
        return False

