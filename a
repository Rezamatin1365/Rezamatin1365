def random_digits(length):
    return ''.join([str(random.randint(0, 9)) for _ in range(length)])

def random_hex(length):
    return ''.join([random.choice('0123456789abcdef') for _ in range(length)])

def bold(text):
    return f"\033[1m{text}\033[0m"

def color(text, code):
    return f"\033[{code}m{text}\033[0m"

def green(text):
    return color(text, "32")

def yellow(text):
    return color(text, "33")

def red(text):
    return color(text, "31")

def cyan(text):
    return color(text, "36")

def magenta(text):
    return color(text, "35")

def blink(text):
    return f"\033[5m{text}\033[0m"

def bg_black(text):
    return f"\033[40m{text}\033[0m"

def line(char="─"):
    print(char * 80)

def double_line():
    print("═" * 80)

def box_top():
    print("╔" + "═" * 78 + "╗")

def box_bottom():
    print("╚" + "═" * 78 + "╝")

def box_line(text, align="left"):
    if align == "center":
        padding = (78 - len(text)) // 2
        line_text = " " * padding + text + " " * (78 - padding - len(text))
    elif align == "right":
        line_text = " " * (78 - len(text)) + text
    else:
        line_text = text + " " * (78 - len(text))
    print("║" + line_text + "║")

